FLASK_DEBUG=1
# mysql = local MySQL (default off Vercel). sqlite = file DB.
# On Vercel, sqlite is automatic (no AERIS_DB needed). Data resets on cold start.
AERIS_DB=mysql
SQLITE_PATH=data/aeris.sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Required if MySQL root has a password (Access denied using password: NO)
MYSQL_PASSWORD=
MYSQL_DATABASE=aeris
# Hosted MySQL (Aiven, PlanetScale, Railway, RDS): MYSQL_SSL=1 and MYSQL_POOL_SIZE=1
MYSQL_SSL=
MYSQL_POOL_SIZE=5
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_SECONDS=86400
CHAIN_URL=http://127.0.0.1:5001
CHAIN_SECRET=dev-chain-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
